new file mode 120000
index 0000000..945c9b4
--- /dev/null
+++ b/qcacld-3.0/.qca6750
@@ -0,0 +1 @@
+.
\ No newline at end of file
diff --git a/qcacld-3.0/Kbuild b/qcacld-3.0/Kbuild
index b054472..134657a 100644
--- a/qcacld-3.0/Kbuild
+++ b/qcacld-3.0/Kbuild
@@ -1273,7 +1273,7 @@ FTM_OBJS := $(FTM_DISP_SRC)/wlan_ftm_init_deinit.o \
 	    $(FTM_CORE_SRC)/wlan_ftm_svc.o \
 	    $(TARGET_IF_FTM_SRC)/target_if_ftm.o
 
-ifeq ($(QCA_WIFI_FTM_NL80211), y)
+ifeq ($(CONFIG_QCA_WIFI_FTM_NL80211), y)
 FTM_OBJS += $(OS_IF_FTM_SRC)/wlan_cfg80211_ftm.o
 endif
 
@@ -3389,6 +3389,15 @@ ifeq ($(findstring yes, $(found)), yes)
 ccflags-y += -DCFG80211_MLD_AP_STA_CONNECT_UPSTREAM_SUPPORT
 endif
 
+# Xiaomi's Bazel build gets these from configs/config_to_feature.h and the
+# DDK include paths. The 6.1 cfg80211 ops already take link_id (wdev->links[]
+# replaced wdev->chandef in 6.0), so select the multi-link prototypes.
+found = $(shell if grep -qF "wdev_chandef" $(srctree)/include/net/cfg80211.h; then echo "yes" ;else echo "no" ;fi;)
+ifeq ($(findstring yes, $(found)), yes)
+ccflags-y += -DCFG80211_SINGLE_NETDEV_MULTI_LINK_SUPPORT
+endif
+ccflags-y += -I$(srctree)/drivers/misc/hwid
+
 ifeq (qca_cld3, $(WLAN_WEAR_CHIPSET))
 	ccflags-y += -DWLAN_WEAR_CHIPSET
 endif
diff --git a/qcacld-3.0/Makefile b/qcacld-3.0/Makefile
index 32910a3..16d3c2e 100644
--- a/qcacld-3.0/Makefile
+++ b/qcacld-3.0/Makefile
@@ -22,6 +22,26 @@ else
 KBUILD_OPTIONS += MODNAME?=wlan
 endif
 
+# LineageOS builds this as qcacld-3.0/.qca6750 (a link to .): take the chip
+# from the directory name, as FP6's qcacld Makefile does, and use the
+# volcano GKI profile that Xiaomi's Bazel build (wlan_qcacld3_modules.bzl) uses.
+WLAN_CHIPSET := qca_cld3
+LOCAL_DEV_NAME := $(patsubst .%,%,\
+	$(lastword $(strip $(subst /, ,$(M)))))
+
+KBUILD_EXTRA := \
+    CONFIG_IPA_OUT_OF_TREE=y \
+    CONFIG_CNSS_OUT_OF_TREE=y \
+    WLAN_PROFILE=$(LOCAL_DEV_NAME) \
+    CONFIG_QCA_CLD_WLAN_PROFILE=volcano_gki_$(LOCAL_DEV_NAME) \
+    DYNAMIC_SINGLE_CHIP=$(LOCAL_DEV_NAME) \
+    MODNAME=$(WLAN_CHIPSET)_$(LOCAL_DEV_NAME) \
+    DEVNAME=$(LOCAL_DEV_NAME)
+
+KBUILD_OPTIONS += \
+    KBUILD_EXTRA_SYMBOLS=$(M)/../../../dataipa/drivers/platform/msm/Module.symvers \
+    KBUILD_EXTRA_SYMBOLS+=$(M)/../../platform/Module.symvers
+
 #By default build for CLD
 WLAN_SELECT := CONFIG_QCA_CLD_WLAN=m
 KBUILD_OPTIONS += CONFIG_QCA_WIFI_ISOC=0
