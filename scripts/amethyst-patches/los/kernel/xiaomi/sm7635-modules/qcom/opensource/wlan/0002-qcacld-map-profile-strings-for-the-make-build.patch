diff --git a/qcacld-3.0/Kbuild b/qcacld-3.0/Kbuild
--- a/qcacld-3.0/Kbuild
+++ b/qcacld-3.0/Kbuild
@@ -45,6 +45,20 @@

 include $(WLAN_ROOT)/configs/$(CONFIG_QCA_CLD_WLAN_PROFILE)_defconfig

+# Xiaomi's Bazel build turns these profile options into defines through
+# configs/config_to_feature.h, but the make rules below test differently
+# named variables. Without WLAN_CTRL_NAME there is no /dev/wlan, which the
+# Wi-Fi HAL (WIFI_DRIVER_STATE_CTRL_PARAM) writes to start the driver.
+# MULTI_IF_NAME keeps stock's names (cldqca6750, /sys/kernel/qca6750).
+ifneq ($(CONFIG_WLAN_CTRL_NAME),)
+WLAN_CTRL_NAME ?= $(patsubst "%",%,$(CONFIG_WLAN_CTRL_NAME))
+endif
+ifneq ($(CONFIG_MULTI_IF_NAME),)
+MULTI_IF_NAME ?= $(patsubst "%",%,$(CONFIG_MULTI_IF_NAME))
+endif
+ENABLE_CE4_COMP_DISABLE_HTT_HTC_MISC_LIST ?= $(CONFIG_ENABLE_CE4_COMP_DISABLE_HTT_HTC_MISC_LIST)
+WLAN_OPEN_SOURCE ?= $(CONFIG_WLAN_OPEN_SOURCE)
+
 # add configurations in WLAN_CFG_OVERRIDE
 $(foreach cfg, $(WLAN_CFG_OVERRIDE), \
 	$(eval $(cfg)) \
