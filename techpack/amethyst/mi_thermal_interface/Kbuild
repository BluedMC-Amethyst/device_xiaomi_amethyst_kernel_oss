# Xiaomi thermal control interface (/sys/class/thermal/thermal_message and
# /sys/class/thermal/power_save) for amethyst; used by mi_thermald, the camera,
# display and codec HALs, LineageOS Parts and qti_battery_charger.
# Source: MiCode Xiaomi_Kernel_OpenSource ziyi-s-oss; see ORIGIN.
#
# The driver finds the thermal class through drivers/base/base.h, as in the
# release, and calls qti_battery_charger's charger_notifier_call_chain().
ccflags-y += -I$(srctree)/drivers/base -I$(srctree)/drivers/thermal \
	-I$(srctree)/drivers/power/supply
# Stock has charger_temp and usb_online (the multi-charge nodes).
ccflags-y += -DCONFIG_MI_THERMAL_MULTI_CHARGE=1
obj-m += mi_thermal_interface.o
