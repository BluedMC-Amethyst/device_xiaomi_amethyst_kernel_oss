# Kernel-image overrides for scripts/build-amethyst-standalone.sh only.
#
# The standalone build merges the vendor module fragments into the kernel
# config, which Kleaf never does. Restore GKI kernel behaviour where a vendor
# fragment would otherwise change it.

# pineapple_GKI.config disables this for vendor modules. GKI modules
# (system_dlkm) must be signed by this kernel's key: unsigned copies cannot
# export GKI protected symbols (rfkill, bluetooth, libarc4, ...).
CONFIG_MODULE_SIG_ALL=y
