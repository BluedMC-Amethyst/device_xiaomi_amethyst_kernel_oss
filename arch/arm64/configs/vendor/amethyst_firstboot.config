# First-boot diagnostics for scripts/build-amethyst-standalone.sh (FIRSTBOOT=1).
# Drop this fragment once the kernel boots to the home screen.

# Stock vendor modules were compiled by Xiaomi. A kCFI type-hash mismatch
# panics on the first indirect call, which looks exactly like a logo hang.
# Permissive mode logs the violation and continues, so the boot survives
# and the report reaches pstore/dmesg.
CONFIG_CFI_PERMISSIVE=y
