/*
 * Amethyst QUPv3 SE12 I2C: two Awinic AW882xx smart PAs (top 0x34, bottom
 * 0x35) and the FSA4480 USB-C audio switch (0x42).
 *
 * Reconstructed from stock dtbo.img (dtbo.img:1, fragments 44) with
 * scripts/amethyst-dtbo-to-dts.py; labels and references are the stock
 * ones from __symbols__, __fixups__ and __local_fixups__.
 */

&qupv3_se12_i2c {
	status = "ok";

	aw882xx_smartpa@34 {
		compatible = "awinic,aw882xx_smartpa";
		reg = <52>;
		reset-gpio = <&tlmm 54 0>;
		irq-gpio = <&tlmm 38 0x2008>;
		pinctrl-names = "default";
		pinctrl-0 = <&aw882xx_irq_active_top>;
		dc-flag = <0>;
		sound-channel = <0>;
		pll-check-disable;
		aw-cali-mode = "aw_none ";
		spksw-gpio = <&tlmm 35 0>;
		fade-flag = <1>;
		status = "ok";
	};

	aw882xx_smartpa@35 {
		compatible = "awinic,aw882xx_smartpa";
		reg = <53>;
		reset-gpio = <&tlmm 146 0>;
		irq-gpio = <&tlmm 52 0x2008>;
		pinctrl-names = "default";
		pinctrl-0 = <&aw882xx_irq_active_bottom>;
		dc-flag = <0>;
		sound-channel = <1>;
		pll-check-disable;
		aw-re-min = <0xfa0>;
		aw-re-max = <0x7530>;
		aw-cali-mode = "aw_none ";
		status = "ok";
	};

	fsa4480: fsa4480@42 {
		status = "ok";
		compatible = "qcom,fsa4480-i2c";
		reg = <66>;
	};
};
